# Copy to .env for local Docker Compose usage. Do not commit .env.
# Replace the demonstration password with your own before sharing a deployment.
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=dataflow
POSTGRES_PORT=5432
API_PORT=8000

# For local Python runs (without Docker), set DATABASE_URL in your terminal:
#   PowerShell: $env:DATABASE_URL = "sqlite:///./data/dataflow.db"
#   Bash:       export DATABASE_URL=sqlite:///./data/dataflow.db
# Docker Compose configures a PostgreSQL DATABASE_URL for its containers.
