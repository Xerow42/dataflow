# Copy this file to .env and adjust as needed.

# PostgreSQL (used by docker-compose and in production)
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dataflow
POSTGRES_PORT=5432

# Full connection string the pipeline and backend read at startup.
# For docker-compose (service name "db" as host):
DATABASE_URL=postgresql://dataflow:change_me@db:5432/dataflow

# For local dev without Docker/Postgres, use SQLite instead:
# DATABASE_URL=sqlite:///./data/dataflow.db

# Backend
API_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
